<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64"><Configuration>Debug</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64"><Configuration>Release</Configuration><Platform>x64</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals"><WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion></PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType><PlatformToolset>v145</PlatformToolset>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'!='Debug'">false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <OutDir>$(MSBuildThisFileDirectory)..\..\Bin\Tests\$(Configuration)\</OutDir>
    <IntDir>$(MSBuildThisFileDirectory)..\..\Intermediate\GameRuntimeTests\$(Configuration)\</IntDir>
  </PropertyGroup>
  <PropertyGroup><SolutionDir>$(MSBuildThisFileDirectory)..\..\</SolutionDir></PropertyGroup>
	<PropertyGroup>
		<SoundEngineLibrary Condition="'$(Configuration)'=='Debug'">SoundEngine-FMod-d.lib</SoundEngineLibrary>
		<SoundEngineLibrary Condition="'$(Configuration)'!='Debug'">SoundEngine-FMod.lib</SoundEngineLibrary>
	</PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard><ExceptionHandling>Sync</ExceptionHandling>
      <WarningLevel>Level4</WarningLevel><PreprocessorDefinitions>FBXSDK_SHARED;NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(SolutionDir)Source\Engine;$(SolutionDir)Source;$(SolutionDir)Source\Utilities;$(SolutionDir)Source\Utilities\CommonUtilities;$(SolutionDir)Source\Application\Game;$(SolutionDir)Dependencies\FMod\include;$(SolutionDir)Dependencies\TGAFBXImporter\source;$(SolutionDir)Dependencies\TGAFBXImporter\FBXSDK\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link><SubSystem>Console</SubSystem><AdditionalOptions>/IGNORE:4099 %(AdditionalOptions)</AdditionalOptions>
      <AdditionalLibraryDirectories>$(SolutionDir)Lib\$(Configuration);$(SolutionDir)Dependencies\TGAFBXImporter\FBXSDK\lib\$(Configuration);$(SolutionDir)Dependencies\FMod\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>GraphicsEngine.lib;$(SoundEngineLibrary);libfbxsdk.lib;libxml2-md.lib;zlib-md.lib;d3d11.lib;dxguid.lib;dxgi.lib;d3dcompiler.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup><ClCompile Include="GameRuntimeTests.cpp" /><ClCompile Include="CameraControlsTests.cpp" />
<ClCompile Include="..\..\Source\Application\Game\Game.cpp" />
<ClCompile Include="..\..\Source\Application\Game\SpinComponent.cpp" />
<ClCompile Include="..\..\Source\Application\Game\GameScene.cpp" />
<ClCompile Include="..\..\Source\Application\Game\MeshLibrary.cpp" />
<ClCompile Include="..\..\Source\Application\Game\PrimitiveMeshBuilder.cpp" />
<ClCompile Include="..\..\Dependencies\TGAFBXImporter\source\Importer.cpp" />
<ClCompile Include="..\..\Dependencies\TGAFBXImporter\source\Internals.cpp" />
<ClCompile Include="..\..\Dependencies\TGAFBXImporter\source\TgaFbxStructs.cpp" /></ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Source\Engine\GameFramework\GameFramework.vcxproj">
      <Project>{cd9f039d-3960-7fd3-029b-c8506e1ac4af}</Project>
      <AdditionalProperties>SolutionDir=$(MSBuildThisFileDirectory)..\..\</AdditionalProperties>
    </ProjectReference>
    <ProjectReference Include="..\..\Source\Utilities\CommonUtilities\CommonUtilities.vcxproj">
      <Project>{aa29e689-16b5-534e-1fc6-d6428bd0af4e}</Project>
      <AdditionalProperties>SolutionDir=$(MSBuildThisFileDirectory)..\..\</AdditionalProperties>
    </ProjectReference>
    <ProjectReference Include="..\..\Source\Utilities\Logger\Logger.vcxproj">
