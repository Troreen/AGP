  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Target Name="CopyFbxRuntime" AfterTargets="Build">
    <Copy SourceFiles="$(SolutionDir)Bin\$(Configuration)\libfbxsdk.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
	<Copy SourceFiles="$(SolutionDir)Dependencies\.dlls\fmod.dll;$(SolutionDir)Dependencies\.dlls\fmodL.dll;$(SolutionDir)Dependencies\.dlls\fmodstudio.dll;$(SolutionDir)Dependencies\.dlls\fmodstudioL.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
